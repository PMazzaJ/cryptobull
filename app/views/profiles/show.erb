<div class="card rounded-4">
  <div class="card-body p-4">
    <div class="position-relative mb-5">
      <img src="assets/images/gallery/profile-cover.png" class="img-fluid rounded-4 shadow" alt="">
      <div class="profile-avatar position-absolute top-100 start-50 translate-middle">
        <% if @user.photo.attached? %>
          <%= image_tag url_for(@user.photo), class: "img-fluid rounded-circle p-1 bg-grd-danger shadow", width: 170, height: 170, alt: "" %>
        <% else %>
          <%= image_tag "assets/images/avatars/01.png", class: "profile-avatar", alt: "" %>
        <% end %>
      </div>
    </div>
    <div class="profile-info pt-5 d-flex align-items-center justify-content-between">
      <div>
        <h3><%= @user.name %> <%= @user.surname %></h3>
        <p class="mb-0">
          <%= @user.city %>, <%= @user.state %>
        </p>
      </div>
    </div>
  </div>
</div>
<div class="row">
  <div class="col-12 col-xl-8">
    <div class="card rounded-4 border-top border-4 border-primary border-gradient-1">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="">
            <h5 class="mb-0 fw-bold">Edit Profile</h5>
          </div>
        </div>
        <%= form_with model: @user, url: profile_path, method: :patch, local: true, class: "row g-4" do |f| %>
          <div class="col-md-6">
            <%= f.label :name, "Nome", class: "form-label" %>
            <%= f.text_field :name, class: "form-control", placeholder: "First Name" %>
          </div>
          <div class="col-md-6">
            <%= f.label :surname, "Sobrenome", class: "form-label" %>
            <%= f.text_field :surname, class: "form-control", placeholder: "Last Name" %>
          </div>
          <div class="col-md-12">
            <%= f.label :phone, "Telefone", class: "form-label" %>
            <%= f.text_field :phone, class: "form-control", placeholder: "Phone" %>
          </div>
          <div class="col-md-12">
            <%= f.label :date_of_birth, "Data de Nascimento", class: "form-label" %>
            <%= f.date_field :date_of_birth, class: "form-control" %>
          </div>
          <div class="col-md-12">
            <%= f.label :country, "País", class: "form-label" %>
            <%= f.text_field :country, class: "form-control", placeholder: "Country" %>
          </div>
          <div class="col-md-6">
            <%= f.label :city, "Cidade", class: "form-label" %>
            <%= f.text_field :city, class: "form-control", placeholder: "City" %>
          </div>
          <div class="col-md-4">
            <%= f.label :state, "Estado", class: "form-label" %>
            <%= f.text_field :state, class: "form-control", placeholder: "State" %>
          </div>
          <div class="col-md-2">
            <%= f.label :zipcode, "Cep", class: "form-label" %>
            <div class="input-group">
              <%= f.text_field :zipcode, class: "form-control", placeholder: "Zip", id: "zipcode_field" %>
              <button type="button" class="btn btn-outline-secondary" onclick="lookupCep()" title="Buscar CEP">
                <span class="material-icons-outlined">search</span>
              </button>
            </div>
          </div>
          <div class="col-md-12">
            <%= f.label :address, "Address", class: "form-label" %>
            <%= f.text_area :address, class: "form-control", placeholder: "Address ...", rows: 4, cols: 4 %>
          </div>
          <div class="col-md-12">
            <%= f.label :photo, "Profile Photo", class: "form-label" %>
            <%= f.file_field :photo, class: "form-control" %>
          </div>
          <div class="col-md-12">
            <div class="d-md-flex d-grid align-items-center gap-3">
              <%= f.submit "Update Profile", class: "btn btn-grd-primary px-4" %>
              <%= button_tag "Reset", type: "reset", class: "btn btn-light px-4" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-4">
    <div class="card rounded-4">
      <div class="card-body">
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="">
            <h5 class="mb-0 fw-bold">Sobre</h5>
          </div>
        </div>
        <div class="full-info">
          <div class="info-list d-flex flex-column gap-3">
            <div class="info-list-item d-flex align-items-center gap-3">
              <span class="material-icons-outlined">account_circle</span>
              <p class="mb-0">Full Name: <%= @user.name %> <%= @user.surname %></p></div>
            <div class="info-list-item d-flex align-items-center gap-3">
              <span class="material-icons-outlined">done</span>
              <p class="mb-0">Status: active</p></div>
            <div class="info-list-item d-flex align-items-center gap-3">
              <span class="material-icons-outlined">code</span>
              <p class="mb-0">Role: Developer</p></div>
            <!--                      <div class="info-list-item d-flex align-items-center gap-3"><span class="material-icons-outlined">flag</span><p class="mb-0">Country: <%#= @user.country %></p></div>-->
            <div class="info-list-item d-flex align-items-center gap-3">
              <span class="material-icons-outlined">language</span>
              <p class="mb-0">Language: English</p></div>
            <div class="info-list-item d-flex align-items-center gap-3">
              <span class="material-icons-outlined">send</span>
              <p class="mb-0">Email: <%= @user.email %></p></div>
            <div class="info-list-item d-flex align-items-center gap-3">
              <span class="material-icons-outlined">call</span>
              <p class="mb-0">Phone: <%= @user.phone %></p></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function lookupCep() {
  const zipcode = document.getElementById('zipcode_field').value;
  
  if (!zipcode || zipcode.length !== 8 || !/^\d+$/.test(zipcode)) {
    alert('Por favor, digite um CEP válido de 8 dígitos');
    return;
  }
  
  // Show loading state
  const button = event.target;
  const originalContent = button.innerHTML;
  button.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
  button.disabled = true;
  
  fetch(`/cep/${zipcode}`)
    .then(response => response.json())
    .then(data => {
      if (data.error) {
        alert(`Erro: ${data.error}`);
        return;
      }
      
      // Show results in a modal or alert
      let message = `Resultados para CEP ${zipcode}:\n\n`;
      data.services.forEach(service => {
        message += `${service.service_name}:\n`;
        if (service.response.error) {
          message += `  Erro: ${service.response.error}\n`;
        } else {
          // Try to extract address info from different service formats
          if (service.service_name === 'ViaCEP') {
            message += `  ${service.response.logradouro}\n`;
            message += `  ${service.response.bairro}, ${service.response.localidade} - ${service.response.uf}\n`;
          } else if (service.service_name === 'APICEP') {
            message += `  ${service.response.address}\n`;
            message += `  ${service.response.district}, ${service.response.city} - ${service.response.state}\n`;
          } else if (service.service_name === 'Postmon') {
            message += `  ${service.response.logradouro}\n`;
            message += `  ${service.response.bairro}, ${service.response.cidade} - ${service.response.estado}\n`;
          }
        }
        message += '\n';
      });
      
      alert(message);
    })
    .catch(error => {
      alert(`Erro na consulta: ${error.message}`);
    })
    .finally(() => {
      // Restore button state
      button.innerHTML = originalContent;
      button.disabled = false;
    });
}
</script>